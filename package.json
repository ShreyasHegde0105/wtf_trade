{
  "name": "trading-companion-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first real-time momentum dashboard for crypto (and later equities) assets.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:client": "vite",
    "dev:mock": "node server/dev/mockCoingecko.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --import ./tests/register-loader.js --test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.1",
    "vite": "^6.0.7"
  }
}
