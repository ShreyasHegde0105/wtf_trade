# ---- Backend (server/) ----
PORT=4000
NODE_ENV=development

# Optional. CoinGecko free "Demo" key (sent as x-cg-demo-api-key). The public
# endpoint works without a key but is rate-limited more aggressively.
COINGECKO_API_KEY=

# Optional. Comma-separated browser origins allowed to call the API cross-origin
# (needed when the frontend is on Vercel and the backend on Railway, or https://localhost for Capacitor Android).
# Example: CORS_ORIGIN=https://localhost,http://localhost:5173
CORS_ORIGIN=

# Optional tuning (defaults shown)
# POLL_INTERVAL_MS=60000
# HEARTBEAT_MS=30000
# UNIVERSE_SIZE=20
# MAX_SSE_CLIENTS=200
# VOLUME_CACHE_TTL_MS=21600000
# VOLUME_REQUEST_DELAY_MS=2500
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Supabase (persistence). Use the service-role / secret key: it bypasses RLS, so it is
# server-only and must never reach the frontend. Leave empty to run without a database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the scoring engine sends as X-WTF-Secret to POST /internal/scores.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WTF_WEBHOOK_SECRET=

# Equity market data. Order: MARKET_DATA_PROVIDER first, then the rest of
# alpha_vantage -> yahoo_finance -> coingecko (CoinGecko has no equity data, so equities
# fall back to Yahoo only; crypto always uses CoinGecko). Alpha Vantage is skipped while the
# key is empty. Server-only secret: never add it to the frontend / Vercel / VITE_ variables.
ALPHA_VANTAGE_API_KEY=
MARKET_DATA_PROVIDER=alpha_vantage
# Optional tuning (defaults shown)
# MARKET_PROVIDER_COOLDOWN_MS=300000     # pause a failing provider (rate limit, 5xx, timeouts)
# MARKET_PROVIDER_FAILURE_THRESHOLD=3    # consecutive 5xx/timeout/network failures before a pause
# ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co

# Equities (Yahoo Finance public chart API is the no-key fallback). Comma-separated US tickers;
# leave empty to run crypto only. Display symbols are stored as-is in Supabase `assets`.
EQUITIES_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA
# Optional tuning (defaults shown)
# EQUITIES_REFRESH_MS=60000              # quote refresh while the US session is open
# EQUITIES_CLOSED_REFRESH_MS=900000      # quote refresh while closed (or at the next open, if sooner)
# EQUITIES_HISTORY_TTL_MS=21600000       # 7-session average volume cache (6h)
# EQUITIES_HISTORY_REQUEST_DELAY_MS=500
# YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com

# ---- Frontend (Vite, build-time) ----
# Leave empty locally. Set to the deployed backend URL in Vercel, e.g. https://your-app.up.railway.app
VITE_API_BASE_URL=
